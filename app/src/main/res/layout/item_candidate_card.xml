<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_candidate_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_candidate_thumbnail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@color/vault_icon_box_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@drawable/item_signed_jersey" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_badge_best_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_badge_best_match"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="@string/disambiguation_best_match_badge"
            android:textAllCaps="true"
            android:textColor="@color/candidate_best_match_badge_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_candidate_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/vault_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Michael Jordan 1998 Finals Jersey" />

        <TextView
            android:id="@+id/tv_candidate_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/vault_text_secondary"
            android:textSize="13sp"
            tools:text="Nike • Edición Finals • NBA" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_candidate_confidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_confidence_high"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="87%" />
</LinearLayout>
