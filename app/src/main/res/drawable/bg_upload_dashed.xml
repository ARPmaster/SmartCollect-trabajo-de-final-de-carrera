<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed strokes don't render under hardware acceleration — the view using this background
     must call setLayerType(LAYER_TYPE_SOFTWARE, null), see NewPostFragment. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/collect_gold"
        android:dashGap="6dp"
        android:dashWidth="6dp" />
    <corners android:radius="16dp" />
</shape>
