<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed strokes don't render under hardware acceleration — the view using this background
     must call setLayerType(LAYER_TYPE_SOFTWARE, null), see NewPostDisambiguationFragment. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/vault_text_secondary"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
    <corners android:radius="12dp" />
</shape>
